<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/results_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy_deep"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <!-- Trophy / Performance Hero Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gradient_hero"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/img_results_trophy"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@string/cd_trophy_icon"
                    android:src="@drawable/ic_trophy" />

                <TextView
                    android:id="@+id/tv_results_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/results_title"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tv_perf_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/gold_yellow"
                    android:textSize="18sp"
                    tools:text="Grandmaster!" />

                <TextView
                    android:id="@+id/tv_perf_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="Phenomenal performance! You have conquered the quiz with near perfection." />
            </LinearLayout>
        </FrameLayout>

        <!-- Big Score Display Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_surface"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_results_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/accent_cyan_bright"
                android:textSize="44sp"
                tools:text="87%" />

            <TextView
                android:id="@+id/tv_results_fraction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                tools:text="13 / 15 Questions Correct" />

            <!-- Best Score Indicator Badge -->
            <TextView
                android:id="@+id/tv_results_best_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip_score"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/gold_yellow"
                android:textSize="12sp"
                tools:text="★ All-time Best: 13 / 15 (87%)" />
        </LinearLayout>

        <!-- Breakdown Statistics Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Correct Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_surface"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle" />

                <TextView
                    android:id="@+id/tv_correct_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/correct_green"
                    android:textSize="20sp"
                    tools:text="13" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/results_correct_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Incorrect Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_surface"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_close_circle" />

                <TextView
                    android:id="@+id/tv_incorrect_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/incorrect_red"
                    android:textSize="20sp"
                    tools:text="2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/results_incorrect_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action: Play Again (Primary) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btn_play_again"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_button_gradient"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.04"
                android:text="@string/btn_play_again"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                app:backgroundTint="@null" />
        </FrameLayout>

        <!-- Action: Review Answers (Secondary) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btn_review_answers"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_secondary"
                android:fontFamily="sans-serif-medium"
                android:text="@string/btn_review_answers"
                android:textAllCaps="false"
                android:textColor="@color/accent_cyan"
                android:textSize="15sp"
                app:backgroundTint="@null" />
        </FrameLayout>

        <!-- Action: Back to Home -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btn_back_home"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/transparent"
                android:fontFamily="sans-serif-medium"
                android:text="@string/btn_back_home"
                android:textAllCaps="false"
                android:textColor="@color/text_muted"
                android:textSize="14sp"
                app:backgroundTint="@null" />
        </FrameLayout>

    </LinearLayout>
</ScrollView>
