<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quiz_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy_deep"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Header: Counter & Score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_question_counter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:textColor="@color/accent_cyan"
                android:textSize="15sp"
                tools:text="Question 1 of 15" />

            <TextView
                android:id="@+id/tv_quiz_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_score"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/badge_score_text"
                android:textSize="13sp"
                tools:text="Score: 0" />
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_quiz"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:max="15"
            android:progress="1"
            android:progressDrawable="@drawable/bg_progress_bar" />

        <!-- Category Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_chip_category"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/cd_category_icon"
                android:src="@drawable/ic_quiz_tag" />

            <TextView
                android:id="@+id/tv_question_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/badge_category_text"
                android:textSize="12sp"
                tools:text="Science" />
        </LinearLayout>

        <!-- Question Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_surface"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_question_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                tools:text="What organelle is famously referred to as the powerhouse of the cell?" />
        </FrameLayout>

        <!-- Answer Options Container -->
        <LinearLayout
            android:id="@+id/layout_options_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <!-- Option 0 -->
            <LinearLayout
                android:id="@+id/layout_option_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_option_normal"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tv_option_badge_0"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_option_letter_circle"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@color/option_letter_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_option_text_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    tools:text="Ribosome" />

                <ImageView
                    android:id="@+id/img_option_status_0"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    tools:src="@drawable/ic_check_circle"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Option 1 -->
            <LinearLayout
                android:id="@+id/layout_option_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_option_normal"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tv_option_badge_1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_option_letter_circle"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="@color/option_letter_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_option_text_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    tools:text="Mitochondria" />

                <ImageView
                    android:id="@+id/img_option_status_1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    tools:src="@drawable/ic_check_circle" />
            </LinearLayout>

            <!-- Option 2 -->
            <LinearLayout
                android:id="@+id/layout_option_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_option_normal"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tv_option_badge_2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_option_letter_circle"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:text="C"
                    android:textColor="@color/option_letter_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_option_text_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    tools:text="Endoplasmic Reticulum" />

                <ImageView
                    android:id="@+id/img_option_status_2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    tools:src="@drawable/ic_close_circle" />
            </LinearLayout>

            <!-- Option 3 -->
            <LinearLayout
                android:id="@+id/layout_option_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_option_normal"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/tv_option_badge_3"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_option_letter_circle"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:text="D"
                    android:textColor="@color/option_letter_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_option_text_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    tools:text="Golgi Apparatus" />

                <ImageView
                    android:id="@+id/img_option_status_3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    tools:src="@drawable/ic_close_circle" />
            </LinearLayout>
        </LinearLayout>

        <!-- Feedback & Explanation Card -->
        <LinearLayout
            android:id="@+id/layout_explanation_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_feedback_box"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/img_feedback_result"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle" />

                <TextView
                    android:id="@+id/tv_feedback_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/correct_green"
                    android:textSize="15sp"
                    tools:text="Correct! Well done." />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/quiz_explanation_header"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_explanation_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Mitochondria generate most of the chemical energy needed to power the cell's biochemical reactions." />
        </LinearLayout>

        <!-- Next / View Results Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <Button
                android:id="@+id/btn_next_question"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_button_gradient"
                android:enabled="false"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.04"
                android:text="@string/quiz_btn_next"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                app:backgroundTint="@null" />
        </FrameLayout>

    </LinearLayout>
</ScrollView>
